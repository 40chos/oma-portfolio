# odoo_manager_agent — template. Copy to .env and fill in real values.
# This is THE single secrets/config file for this project -- every
# credential, address, and port goes here and nowhere else. Never commit
# .env itself. Every module reads these dynamically via
# infra/settings.py -> os.environ; never hardcode a value from here
# into any other file.

# ── Postgres (postgres-dev.int, real dev-tier instance) ──────────────────
# Own, separate database on the shared instance -- never the database or
# schema other dev agents already use.
OMA_PG_HOST=10.1.13.144
OMA_PG_PORT=5432
OMA_PG_DB=odoo_manager_dev
OMA_PG_USER=
OMA_PG_PASSWORD=

# ── Redis (redis-dev.int, real dev-tier instance) ─────────────────────────
# Check current DB usage before picking one (DBSIZE per index) -- do not
# assume an index is free without checking first.
OMA_REDIS_HOST=10.1.13.143
OMA_REDIS_PORT=6379
OMA_REDIS_USER=
OMA_REDIS_PASSWORD=
OMA_REDIS_DB=

# ── Model gateway (Phase 2+; two dedicated resident hosts as of 2026-07-13) ─
# GPU Worker 01 (coder host): 10.1.19.195:9090, OpenAI-compatible
# llama-swap proxy in front of vLLM. This host now serves ONLY
# qwen3-coder-30b-a3b -- the app-layer routing in infra/gateway_client.py
# guarantees no other model name is ever requested from it, so it stays
# permanently resident (no reload tax).
# GPU Worker 02 (reasoning host): 10.1.19.203:9090, same stack. Serves
# ONLY the one shared reasoning model, used for every non-coder role
# (manager, classifier, code-review, testing/QA routine + escalation).
# Its own /v1/models exposes that model under the host alias
# `JA-GPU2-27B-INT4-64K`, not `qwen3.6-27b` -- infra/gateway_client.py
# translates this automatically; every OMA_MODEL_* value below stays the
# stable logical name `qwen3.6-27b`.
# NOT the sandbox's LiteLLM (that's Phase 14 only) and NOT the
# decommissioned 10.1.19.194 Ollama target.
OMA_MODEL_GATEWAY_URL_CODER=http://10.1.19.195:9090/v1
OMA_MODEL_GATEWAY_URL_REASONING=http://10.1.19.203:9090/v1
OMA_MODEL_GATEWAY_API_KEY=
OMA_MODEL_MANAGER=qwen3.6-27b
OMA_MODEL_BUILD=qwen3-coder-30b-a3b
# qwen3-14b and deepseek-r1-distill-qwen-32b are retired (2026-07-13) --
# every non-coder role now shares the one resident reasoning model above,
# not a separate swapped-in tier.
OMA_MODEL_CLASSIFIER=qwen3.6-27b
OMA_MODEL_TESTING_QA_ESCALATION=qwen3.6-27b

# ── Odoo target (Phase 7+) ────────────────────────────────────────────────
# Real dev-copy: odoo-dev.int, container `odoo16-dev`, port 8071 (bound
# to 127.0.0.1 on that host only -- tunnel via
# `ssh -f -N -L 18071:127.0.0.1:8071 andrew@odoo-dev.int`). Point
# OMA_ODOO_URL at the local tunnel endpoint. NEVER port 8070 / db
# 16_202012 (Production, container `odoo16`) -- infra/odoo_settings.py
# hardcodes an allow-list assertion for exactly this.
OMA_ODOO_URL=http://127.0.0.1:18071
OMA_ODOO_DB=odoo16_dev
OMA_ODOO_USER=
OMA_ODOO_API_KEY=
OMA_ODOO_MASTER_PASSWORD=

# ── Odoo SSH (container/code/log management, Phase 7/8) ──────────────────
OMA_ODOO_SSH_HOST=odoo-dev.int
OMA_ODOO_SSH_USER=andrew
OMA_ODOO_SSH_CONTAINER=odoo16-dev
