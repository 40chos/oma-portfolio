# oma — template. Copy to .env and fill in real values (or just use the
# docker-compose defaults below for a local run -- they're fine for a
# single-machine demo, not meant for anything exposed to the internet).
# This is THE single secrets/config file for this project -- every
# credential, address, and port goes here and nowhere else. Never commit
# .env itself. Every module reads these dynamically via
# infra/settings.py -> os.environ; never hardcode a value from here
# into any other file.

# ── Postgres (docker-compose service `postgres`) ─────────────────────────
OMA_PG_HOST=postgres
OMA_PG_PORT=5432
OMA_PG_DB=oma
OMA_PG_USER=oma
OMA_PG_PASSWORD=oma_dev_password

# ── Redis (docker-compose service `redis`) ────────────────────────────────
OMA_REDIS_HOST=redis
OMA_REDIS_PORT=6379
OMA_REDIS_USER=default
OMA_REDIS_PASSWORD=oma_dev_password
OMA_REDIS_DB=0

# ── Neo4j (docker-compose service `neo4j`) ────────────────────────────────
# Deliberately unprefixed (NEO4J_* not OMA_NEO4J_*) -- matches the neo4j
# Python driver's own conventional env var names.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=oma_dev_password

# ── Model gateway (Stage 3) ────────────────────────────────────────────────
# OMA_LLM_MODE=local uses the `ollama` compose service (default, zero API
# cost, fully self-hosted); OMA_LLM_MODE=cloud uses infra/cloud_escalation.py's
# Anthropic path instead, for higher-quality demos. See DECISIONS.md.
OMA_LLM_MODE=local
OMA_MODEL_GATEWAY_URL_CODER=http://ollama:11434/v1
OMA_MODEL_GATEWAY_URL_REASONING=http://ollama:11434/v1
OMA_MODEL_GATEWAY_API_KEY=
OMA_CLOUD_ESCALATION_API_KEY=

# ── Odoo target (docker-compose service `odoo`) ───────────────────────────
# Single container, reached directly over compose networking -- no SSH
# tunnel. infra/odoo_settings.py still enforces its allow-list guard
# (OMA_ODOO_DB must be exactly the canonical name or a recognized
# duplicate/sandbox pattern) even though there's only one real target here;
# see that module's docstring for why the guard is kept rather than dropped.
OMA_ODOO_URL=http://odoo:8069
OMA_ODOO_DB=odoo16_dev
OMA_ODOO_USER=admin
OMA_ODOO_API_KEY=
OMA_ODOO_MASTER_PASSWORD=admin
OMA_ODOO_REMOTE_PORT=8071

# ── Gitea (Stage 4, docker-compose service `gitea`) ───────────────────────
DEV_AGENT_GITEA_URL=http://gitea:3000
DEV_AGENT_GITEA_TOKEN=
DEV_AGENT_GITEA_ORG=oma
DEV_AGENT_GITEA_GENERATED_MODULES_REPO=oma-generated-modules
