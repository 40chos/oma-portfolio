<odoo>
    <record id="demo_widget_form" model="ir.ui.view">
        <field name="name">demo.widget.form</field>
        <field name="model">demo.widget</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="code"/>
                    <notebook>
                        <page>
                            <field name="description"/>
                            <field name="line_ids">
                                <tree>
                                    <field name="qty"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </group>
            </form>
        </field>
    </record>

    <record id="demo_widget_inherit" model="ir.ui.view">
