        <field name="model">demo.widget</field>
        <field name="inherit_id" ref="fixture_view_nested.demo_widget_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <field name="extra_note"/>
            </xpath>
        </field>
    </record>

    <record id="demo_orphan_view_no_model" model="ir.ui.view">
        <field name="name">demo.orphan.no.model</field>
        <field name="arch" type="xml">
            <form>
                <field name="should_not_be_collected_into_views_primary"/>
            </form>
        </field>
    </record>
</odoo>
